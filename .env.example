# HealthLoop Environment Configuration
PORT=5000
SECRET_KEY=healthloop-secret-key-production-ready
JWT_SECRET_KEY=healthloop-jwt-token-secret-health-tech

# MongoDB Database Connection
# If MongoDB is running locally or on Atlas, set the URI here:
MONGO_URI=mongodb://localhost:27017/healthloop_db
DB_NAME=healthloop_db

# Google Gemini API Key for AI Health Coach
# Get your free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Frontend URL for CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
